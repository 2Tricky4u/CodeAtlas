{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.local/schemas/validation-result.v1.json",
  "title": "Finding Validation Result",
  "description": "Adversarial validator's verdict on one candidate finding. The validator can only classify the finding it was given; there is deliberately no channel to introduce new findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findingId",
    "status",
    "severity",
    "confidence",
    "introducedByChange",
    "location",
    "claim",
    "evidence",
    "counterEvidenceChecked",
    "publicationEligible"
  ],
  "properties": {
    "findingId": { "type": "string", "pattern": "^F-[0-9]{4}$" },
    "status": { "enum": ["validated", "rejected", "duplicate", "unresolved"] },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "introducedByChange": { "type": "boolean" },
    "duplicateOf": { "type": ["string", "null"], "pattern": "^F-[0-9]{4}$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" }
      }
    },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "test",
              "command",
              "call-path",
              "static-analysis",
              "compiler",
              "schema",
              "repository-rule",
              "independent-review"
            ]
          },
          "command": { "type": "string" },
          "exitCode": { "type": "integer" },
          "artifact": { "type": "string" }
        }
      }
    },
    "counterEvidenceChecked": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "publicationEligible": { "type": "boolean" },
    "reason": { "type": "string" }
  }
}
