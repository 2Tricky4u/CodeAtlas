{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.local/schemas/protocol-model.v1.json",
  "title": "Protocol Model",
  "description": "Machine-readable protocol description; sequence and state diagrams are derived views of this model, never independent artifacts. `protocol` may be null — most projects have no protocol worth modelling, and a batch program forced into a sequence diagram produces a confident-looking picture of something that does not exist. Every participant and every message carries the source range it was read from, so an element nobody can point at is removed rather than drawn.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocol": {
      "description": "Absent or null when this project has no protocol. Both forms are accepted because a producer naturally writes an explicit null; canonical output omits the key, as it does for every nullable field in these contracts.",
      "oneOf": [{ "$ref": "#/$defs/protocol" }, { "type": "null" }]
    },
    "droppedElements": {
      "description": "Participants, messages and timeouts removed because their evidence did not resolve, with the reason. Present so a thin model is visibly thin rather than quietly so.",
      "type": "array",
      "items": { "$ref": "#/$defs/droppedElement" }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "transport", "framing", "participants", "states", "messages", "timeouts", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "framing": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/participant" }
        },
        "states": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "producer", "consumer", "evidence"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "producer": {
                "description": "A participant name declared above.",
                "type": "string",
                "minLength": 1
              },
              "consumer": { "type": "string", "minLength": 1 },
              "schema": { "type": ["string", "null"] },
              "evidence": {
                "description": "Where this message is sent or handled. Required: a message with no source range is a claim about a protocol nobody can check.",
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "timeouts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "duration", "transition"],
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "duration": { "type": "string", "pattern": "^P" },
              "transition": { "type": "string", "minLength": 1 },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        },
        "evidence": {
          "description": "Where the protocol as a whole is defined — the module that owns the wire format.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbol": {
          "description": "A graph node id, when the element corresponds to one.",
          "type": "string"
        },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "droppedElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "reason"],
      "properties": {
        "kind": { "enum": ["participant", "message", "timeout"] },
        "name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
