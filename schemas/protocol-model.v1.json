{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.local/schemas/protocol-model.v1.json",
  "title": "Protocol Model",
  "description": "Machine-readable protocol description; sequence/state diagrams are derived views of this model, never independent artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol"],
  "properties": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "transport", "framing", "participants", "states", "messages", "timeouts", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "framing": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "states": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "producer", "consumer"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "producer": { "type": "string", "minLength": 1 },
              "consumer": { "type": "string", "minLength": 1 },
              "schema": { "type": ["string", "null"] }
            }
          }
        },
        "timeouts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "duration", "transition"],
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "duration": { "type": "string", "pattern": "^P" },
              "transition": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "symbol": { "type": "string" },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
