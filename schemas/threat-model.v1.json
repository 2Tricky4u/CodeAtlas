{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.local/schemas/threat-model.v1.json",
  "title": "Threat Model",
  "description": "Repo-wide threat model: trust boundaries, assets, an attacker whose non-capabilities are stated as explicitly as their capabilities, abuse paths with stable TM-nnn ids, and 2-30 focus paths that aim the reviewers. Cached per repository — a threat model describes what the system is, which changes far more slowly than any one revision. A repo with no meaningful attack surface says so with `threats: []` and a written reason in notes; boundaries are never invented to fill the form. Every component, boundary and control claim carries evidence, and an element nobody can point at is removed rather than kept.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modeledAtRevision", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "modeledAtRevision": {
      "description": "The revision the model was built at. A consumer at a later revision knows exactly how stale its picture is.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "summary": {
      "description": "What this system is, attack-surface-wise, in a paragraph.",
      "type": "string",
      "minLength": 1
    },
    "components": {
      "description": "The units the boundaries connect. A boundary between undeclared components is dropped.",
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "attacker": {
      "description": "Who is being defended against. `nonCapabilities` is required alongside `capabilities` because it is what keeps severity honest: a threat the stated attacker cannot mount is not high.",
      "$ref": "#/$defs/attacker"
    },
    "threats": {
      "description": "Abuse paths with stable ids. Empty is a valid, honest answer.",
      "type": "array",
      "items": { "$ref": "#/$defs/threat" }
    },
    "criticality": {
      "description": "What each severity word means for THIS repo, so 'high' in a demo crate and 'high' in a keystore are not the same claim.",
      "$ref": "#/$defs/criticality"
    },
    "focusPaths": {
      "description": "Where a reviewer's attention buys the most. Empty, or 2-30: a single 'focus path' is a token gesture, and more than 30 is no focus at all.",
      "type": "array",
      "items": { "$ref": "#/$defs/focusPath" },
      "maxItems": 30,
      "not": { "minItems": 1, "maxItems": 1 }
    },
    "droppedElements": {
      "description": "Elements removed because their evidence did not resolve, with the reason. Present so a thin model is visibly thin rather than quietly so.",
      "type": "array",
      "items": { "$ref": "#/$defs/droppedElement" }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "between", "dataCrossing", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "between": {
          "description": "Component names declared above.",
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "dataCrossing": { "$ref": "#/$defs/dataCrossing" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "dataCrossing": {
      "description": "All four fields are required: a boundary whose guarantees or validation go unstated is exactly the vagueness this artifact exists to remove.",
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "channel", "guarantees", "validation"],
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "channel": { "type": "string", "minLength": 1 },
        "guarantees": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "whyItMatters", "cia"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "whyItMatters": { "type": "string", "minLength": 1 },
        "cia": {
          "description": "Which of confidentiality, integrity, availability actually matter for this asset — not all three by default.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["confidentiality", "integrity", "availability"] }
        }
      }
    },
    "attacker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "nonCapabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nonCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source", "action", "impact", "likelihood", "severity"],
      "properties": {
        "id": { "type": "string", "pattern": "^TM-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "action": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "impactedAssets": {
          "description": "Asset names declared above.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "existingControls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mitigations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "likelihood": { "enum": ["low", "medium", "high"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "control": {
      "description": "Threats are hypotheses; control claims are checkable. A control whose evidence did not resolve keeps its description but is marked unverified, never silently trusted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "verified": { "type": "boolean" }
      }
    },
    "criticality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": { "type": "string", "minLength": 1 },
        "high": { "type": "string", "minLength": 1 },
        "medium": { "type": "string", "minLength": 1 },
        "low": { "type": "string", "minLength": 1 }
      }
    },
    "focusPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "threatIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^TM-[0-9]{3}$" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbol": {
          "description": "A graph node id, when the element corresponds to one.",
          "type": "string"
        },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "droppedElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "reason"],
      "properties": {
        "kind": { "enum": ["component", "boundary", "asset", "threat", "focusPath", "control"] },
        "name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
