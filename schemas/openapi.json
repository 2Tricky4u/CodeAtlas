    "/api/runs/{run_id}/invocations": {
      "get": {
        "description": "The agent ledger: who answered, with which model, at what cost.\n\nEvery dispatch leaves a row; on a product whose thesis is \"everything\ntraceable to evidence\", the ledger itself was unreachable \u2014 the\ndashboard could not say which skill produced a claim or what it cost.",
        "operationId": "run_invocations_api_runs__run_id__invocations_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Run Invocations Api Runs  Run Id  Invocations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Invocations"
      }
    },
    "/api/runs/{run_id}/overview": {
      "get": {
        "description": "What this project is: entry points, levels, cycles, where to start.",
        "operationId": "run_overview_api_runs__run_id__overview_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Overview Api Runs  Run Id  Overview Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Overview"
      }
    },
    "/api/runs/{run_id}/publications": {
      "get": {
        "description": "What actually left the machine for this run \u2014 usually nothing.\n\nThe review tab used to hard-code \"nothing was sent\", which becomes a\nfalse statement the moment `codeatlas publish` succeeds. This row is\nwhat decides; the dashboard reads it instead of asserting it.",
        "operationId": "run_publications_api_runs__run_id__publications_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Run Publications Api Runs  Run Id  Publications Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Publications"
      }
    },
    "/api/runs/{run_id}/views": {
      "get": {
        "description": "Bounded, readable views of the project graph, with refusals stated.",
        "operationId": "run_views_api_runs__run_id__views_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Views Api Runs  Run Id  Views Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Views"
      }
    },
    "/api/source/{revision_sha}": {
      "get": {
        "operationId": "source_api_source__revision_sha__get",
        "parameters": [
          {
            "in": "path",
            "name": "revision_sha",
            "required": true,
            "schema": {
              "title": "Revision Sha",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Path",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Start",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Source Api Source  Revision Sha  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Source"
      }
    }
  }
}
